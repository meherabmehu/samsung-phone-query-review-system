# Copy this file to `.env` and fill in real values.
# NEVER commit the real `.env` file (it is gitignored).

# --- Database -------------------------------------------------------------
# PostgreSQL connection string (primary database).
DATABASE_URL=postgresql+psycopg2://app:app_pass@localhost:5432/samsung_phones
# For a quick, dependency-free run you can use SQLite instead:
# DATABASE_URL=sqlite:///./data/samsung_phones.db

# --- RAG / embeddings -----------------------------------------------------
# Sentence-transformers embedding model for retrieval.
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2

# --- LLM provider (optional) ---------------------------------------------
# The chatbot works out of the box with a grounded fallback generator that
# only uses retrieved database context. To plug in a real LLM, configure
# ONE of the providers below and set LLM_PROVIDER accordingly.

# "fallback" (default) | "huggingface" | "openai" | "ollama"
LLM_PROVIDER=fallback

# Hugging Face Inference API (open-source models)
HUGGINGFACE_API_KEY=
HUGGINGFACE_API_URL=https://api-inference.huggingface.co/models/mistralai/Mistral-7B-Instruct-v0.2

# OpenAI-compatible endpoint (OpenAI, Groq, vLLM, ...)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Local Ollama server
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# --- Scraper --------------------------------------------------------------
# Comma separated slug suffixes or "all" to scrape every Samsung phone.
# SCRAPE_TARGETS=galaxy_s23,galaxy_s22_5g,galaxy_s24
SCRAPE_TARGETS=all
# Polite delay between page requests (seconds).
SCRAPE_DELAY=1.0
